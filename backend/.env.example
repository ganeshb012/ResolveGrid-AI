# ResolveGrid AI Environment Configuration

# Project
PROJECT_NAME="ResolveGrid AI"
DEBUG=true

# Database (SQLite primary storage)
DATABASE_URL="sqlite:///D:/RESOLVEGRID AI/backend/data/resolvegrid.db"

# JWT Auth Secret
SECRET_KEY="resolvegrid-ai-super-secret-key-2026-production-ready-jwt-token"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Background Task Broker (Optional: set up Memurai / Redis for Celery)
REDIS_URL="redis://127.0.0.1:6379/0"
TASK_FALLBACK_MODE=false # Set to false if Celery + Redis is running

# Gnani AI API Model Credentials
# When provided, system switches from typed simulation fallback to real Gnani API calls:
GNANI_API_KEY="your_gnani_api_key_here"
GNANI_TOKEN=""
GNANI_PRISMA_URL="https://api.vachana.ai/stt/v3"
GNANI_EVON_URL=""
GNANI_TIMBRE_URL="https://api.vachana.ai/api/v1/tts/inference"
GNANI_WARP_URL=""

# Enable local simulation fallback when API keys are not yet configured:
GNANI_MOCK_FALLBACK=true

# Render/Production Persistent Storage paths
# DATA_DIR="/var/data/data"
# UPLOADS_DIR="/var/data/uploads"
# CORS_ORIGINS="https://resolvegrid.vercel.app"

